# Copy this file to ".env" (same folder) and fill in your key.
# ".env" is already git-ignored, so it never gets committed.
#
# Powers the Metrik chatbot (backend/utils/chatbot_mock.py) via Groq's
# free-tier API (a Llama model) - no cost, just a free account.
# Get a key at: https://console.groq.com/keys
#
# Without this set, the chatbot falls back to a fixed set of canned
# rule-based answers instead of a real conversation.
GROQ_API_KEY=gsk_your-key-here
